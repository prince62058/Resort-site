# Server-only settings. Copy to .env locally; set these in Hostinger's environment settings.
# Never prefix the database URI with VITE_ or commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0
MONGODB_DB=nature_nest
MEDIA_BUCKET=resort_media
PORT=5174
# Generate locally with npm run admin:setup-token and copy the value into Hostinger.
# Required only for initial owner creation. Never use a public / VITE_ variable.
ADMIN_SETUP_TOKEN=
# Set NODE_ENV=production on Hostinger for HTTPS-only admin cookies.
